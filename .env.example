# ---------------------------------------------------------------------------
# Local development template. Copy to .env, then `php artisan key:generate`.
# For a live server start from .env.production.example instead — it carries
# the safe defaults (debug off, https cookies, daily logs).
# ---------------------------------------------------------------------------

APP_NAME="Lucent Optics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.6+. Create the schema first:
#   CREATE DATABASE lucent_optics CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# If your provider gave you a single connection URI instead, put it in DB_URL,
# set DB_CONNECTION to match its scheme (pgsql for postgresql://), and comment
# out the five DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD lines —
# blanking them is not the same as removing them (a blank DB_PORT= overrides
# the driver default and breaks the connection):
#   DB_URL=postgresql://user:password@host/dbname?sslmode=require
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lucent_optics
DB_USERNAME=root
DB_PASSWORD=

# Sessions, cache and the queue all live in database tables (created by the
# 0001_01_01_* migrations), so a fresh install needs no Redis or Memcached.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Frame photos and prescription scans are written to storage/app; keep this
# on "local" unless you have moved uploads to S3.
FILESYSTEM_DISK=local

# Promotion campaign emails are pushed onto this queue, so a worker has to be
# running for them to leave the building (see DEPLOYMENT.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes campaign mail to storage/logs instead of sending it — the right
# default for development. Point at a real SMTP host or API driver in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lucentoptics.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Storefront WhatsApp chat button. Pure wa.me deep link — no API key and no
# provider account. Full international number, country code included and the
# local leading zero dropped (e.g. 96171234567). Leave WHATSAPP_NUMBER empty
# to hide the button.
WHATSAPP_ENABLED=true
WHATSAPP_NUMBER=
WHATSAPP_LABEL="Lucent Optics"
WHATSAPP_HOURS="Mon-Sat, 9:00-18:00"

# About page contact block: phone, email, address and social links printed on
# /about and in the site footer (config/contact.php). Every SOCIAL entry is
# optional — leave one empty and its icon is simply not rendered.
CONTACT_PHONE="+961 1 785 400"
CONTACT_EMAIL="hello@lucentoptics.com"
CONTACT_SUPPORT_EMAIL=
CONTACT_ADDRESS="Verdun Street, Ras Beirut"
CONTACT_CITY="Beirut"
CONTACT_COUNTRY="Lebanon"
CONTACT_HOURS="Mon-Fri 9:00-18:00 - Sat 10:00-16:00"
CONTACT_MAP_URL=
CONTACT_FACEBOOK="https://www.facebook.com/lucentoptics"
CONTACT_INSTAGRAM="https://www.instagram.com/lucentoptics"
CONTACT_TWITTER="https://x.com/lucentoptics"
CONTACT_YOUTUBE="https://www.youtube.com/@lucentoptics"
CONTACT_TIKTOK=
CONTACT_LINKEDIN=
