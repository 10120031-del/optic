# ---------------------------------------------------------------------------
# Local development template. Copy to .env, then `php artisan key:generate`.
# For a live server start from .env.production.example instead — it carries
# the safe defaults (debug off, https cookies, daily logs).
# ---------------------------------------------------------------------------

APP_NAME="Lucent Optics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.6+. Create the schema first:
#   CREATE DATABASE lucent_optics CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lucent_optics
DB_USERNAME=root
DB_PASSWORD=

# Sessions, cache and the queue all live in database tables (created by the
# 0001_01_01_* migrations), so a fresh install needs no Redis or Memcached.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Frame photos and prescription scans are written to storage/app; keep this
# on "local" unless you have moved uploads to S3.
FILESYSTEM_DISK=local

# Promotion campaign emails are pushed onto this queue, so a worker has to be
# running for them to leave the building (see DEPLOYMENT.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes campaign mail to storage/logs instead of sending it — the right
# default for development. Point at a real SMTP host or API driver in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lucentoptics.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
