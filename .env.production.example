# ---------------------------------------------------------------------------
# Production template — copy to .env on the server and fill in the blanks.
#
#   cp .env.production.example .env
#   php artisan key:generate      # writes APP_KEY; run ONCE, never re-run on a
#                                 # live site or every encrypted value and every
#                                 # active session becomes unreadable.
#
# Keep the file out of git (already in .gitignore) and off world-readable
# permissions: chmod 640 .env, owned by the deploy user, group www-data.
# ---------------------------------------------------------------------------

APP_NAME="Lucent Optics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Password hashing cost. 12 is the sane floor; raise only if you have measured
# the login latency you are willing to pay for.
BCRYPT_ROUNDS=12

# Daily files, pruned after two weeks, at "error" so the log is signal not
# noise. Swap LOG_STACK for "stderr" on a container platform that collects
# stdout, or add a Slack/Sentry channel for alerting.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database ----------------------------------------------------------------
# Two ways to point at the database — use one or the other, not both.
#
# a) A single connection URI, which is what hosted providers hand you
#    (Neon / Netlify DB, Supabase, Railway, Heroku, PlanetScale). Laravel
#    parses it into host/port/database/username/password, and query-string
#    options such as ?sslmode=require override config/database.php. Set
#    DB_CONNECTION to match the URI's scheme — pgsql for postgresql:// — and
#    keep everything after the "?" exactly as the provider gave it.
#
#      DB_CONNECTION=pgsql
#      DB_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
#
#    IMPORTANT: comment out or delete the five DB_HOST/DB_PORT/DB_DATABASE/
#    DB_USERNAME/DB_PASSWORD lines below when you do this. Leaving them *blank*
#    is not the same as removing them — a blank DB_PORT= is read as an empty
#    port and overrides the driver's default (5432), which fails to connect
#    with a misleading error. Most managed URIs carry no port at all.
#
# b) The individual fields, for a database you administer yourself.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lucent_optics
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your bare domain (".example.com" to share across subdomains).
SESSION_DOMAIN=
# The session cookie must never travel over plain http on a live shop.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Set if several apps share one cache backend.
# CACHE_PREFIX=lucent

# --- Mail --------------------------------------------------------------------
# Promotion campaigns are queued, so this only matters once the queue worker is
# running. MAIL_MAILER=log silently swallows customer mail — change it.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional: uploads on S3 -------------------------------------------------
# Only needed if you set FILESYSTEM_DISK=s3. On a single server the local disk
# plus `php artisan storage:link` is enough; on more than one web node the
# uploads must be shared, and S3 is the simplest way to do that.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public URL prefix for the storage symlink. Point at a CDN to serve frame
# photos from the edge; leave as-is to serve them from this host.
# STORAGE_URL=https://cdn.example.com/storage

VITE_APP_NAME="${APP_NAME}"
